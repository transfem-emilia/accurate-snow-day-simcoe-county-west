<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta property="og:title" content="Bus Cancellation Predictor - Emilia" />
  <meta property="og:description" content="Weather-based school bus cancellation predictions for Simcoe County" />
  <meta property="og:type" content="website" />
  <title>Bus Cancellation Predictor - Emilia</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Mea+Culpa&family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
  <style>
    @font-face {
        font-family: 'SF Pro Display', sans-serif;
        src: url('fonts/SFProDisplay-Bold.woff2') format('woff2');
        font-weight: bold;
        font-style: normal;
    }

    @font-face {
        font-family: 'Mea Culpa';
        src: local('Mea Culpa Regular'), local('MeaCulpa-Regular'),
            url('../fonts/MeaCulpa-Regular.woff2') format('woff2'),
            url('../fonts/MeaCulpa-Regular.woff') format('woff');
        font-weight: normal;
        font-style: normal;
        font-display: auto;
    }

    @font-face {
        font-family: 'Mea Culpa';
        src: local('Mea Culpa Regular'), local('MeaCulpa-Regular'),
            url('../fonts/MeaCulpa-Regular.woff2') format('woff2'),
            url('../fonts/MeaCulpa-Regular.woff') format('woff');
        font-weight: normal;
        font-style: normal;
        font-display: auto;
    }

    body {
      background-color: #3c2a34;
      padding-top: 54px !important;
      margin-top: 0 !important;
      margin: 0;
      font-family: "Montserrat", sans-serif;
      color: #f2b3c0;
    }

    h1, h2, h3, h4 {
      font-family: "Montserrat", sans-serif;
      font-optical-sizing: auto;
      font-weight: 500;
      font-style: normal;
      text-align: center;
      color: #f36a85;
    }

    h1 {
      font-size: 32pt;
      margin: 20px 0;
    }

    .title {
      font-family: 'Mea Culpa';
      font-size: 50pt;
      text-align: center;
      color: #f36a85;
      margin: 20px 0;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 20px;
    }

    .timestamp {
      text-align: center;
      color: #f2b3c0;
      font-size: 14px;
      margin-bottom: 30px;
      font-family: 'SF Pro Display', sans-serif;
      font-weight: bold;
    }

    .loading {
      text-align: center;
      color: #f36a85;
      font-size: 18px;
      margin: 40px 0;
    }

    .location-card {
      background-color: rgba(242, 179, 192, 0.1);
      border-radius: 8px;
      padding: 25px;
      margin-bottom: 25px;
      border: 2px solid #f2b3c0;
      position: relative;
    }

    .location-card.cancelled {
      border-left: 8px solid #f36a85;
      background-color: rgba(243, 106, 133, 0.15);
    }

    .location-card.not-cancelled {
      border-left: 8px solid #85f3a8;
      background-color: rgba(133, 243, 168, 0.1);
    }

    .card-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
      flex-wrap: wrap;
      gap: 15px;
    }

    .location-name {
      font-size: 28px;
      font-weight: bold;
      color: #f36a85;
      margin: 0;
      font-family: "Montserrat", sans-serif;
    }

    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 10px;
    }

    .status {
      font-size: 20px;
      font-weight: bold;
      padding: 8px 20px;
      border-radius: 25px;
      font-family: 'SF Pro Display', sans-serif;
    }

    .status.cancelled {
      background-color: #f36a85;
      color: white;
    }

    .status.running {
      background-color: #85f3a8;
      color: #3c2a34;
    }

    .confidence {
      background-color: #f2b3c0;
      color: #3c2a34;
      padding: 8px 15px;
      border-radius: 20px;
      font-size: 14px;
      font-weight: bold;
      font-family: 'SF Pro Display', sans-serif;
    }

    .reasons {
      margin-top: 20px;
    }

    .reasons-title {
      color: #f36a85;
      font-weight: bold;
      margin-bottom: 10px;
      font-size: 16px;
    }

    .reason {
      background-color: rgba(243, 106, 133, 0.2);
      border: 1px solid #f36a85;
      padding: 12px 15px;
      margin: 8px 0;
      border-radius: 6px;
      color: #f2b3c0;
      font-size: 14px;
    }

    .hazards {
      margin-top: 20px;
      padding-top: 15px;
      border-top: 1px solid rgba(242, 179, 192, 0.3);
      font-size: 14px;
      color: #f2b3c0;
    }

    .hazards strong {
      color: #f36a85;
    }

    button {
      margin: 10px auto;
      padding: 12px 25px;
      background-color: #f36a85;
      border: 2px solid white;
      color: white;
      cursor: pointer;
      font-size: 16px;
      border-radius: 5px;
      font-family: 'SF Pro Display', sans-serif;
      font-weight: bold;
      display: block;
      transition: opacity 0.2s;
    }

    button:hover {
      opacity: 0.8;
    }

    .error {
      background-color: rgba(243, 106, 133, 0.2);
      border: 2px solid #f36a85;
      padding: 20px;
      border-radius: 8px;
      text-align: center;
      color: #f2b3c0;
      margin: 20px 0;
    }

    .spacer {
      color: #3c2a34;
      user-select: none;
    }

    @media (max-width: 768px) {
      .card-header {
        flex-direction: column;
        align-items: flex-start;
      }

      .location-name {
        font-size: 24px;
      }

      .status {
        font-size: 18px;
      }

      h1 {
        font-size: 24pt;
      }

      .title {
        font-size: 36pt;
      }
    }
  </style>
</head>

